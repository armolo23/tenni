####################################
# IMPORTANT: Copy this to .env and fill in secure values
# Generate secrets with: openssl rand -base64 32
####################################

####################################
# General
####################################
PORT=8055
PUBLIC_URL=http://localhost:8055

####################################
# Database
####################################
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tenni
DB_USER=directus
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

####################################
# Security
####################################
SECRET=CHANGE_ME_32_CHAR_SECRET
KEY=CHANGE_ME_32_CHAR_KEY
ADMIN_EMAIL=admin@tennisportal.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

####################################
# Authentication
####################################
AUTH_PROVIDERS=
REFRESH_TOKEN_TTL=7d
ACCESS_TOKEN_TTL=15m

# Cookie-based auth settings
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_NAME=directus_refresh_token

####################################
# CORS (for React frontend)
####################################
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

####################################
# Email (Optional - for registration verification)
####################################
EMAIL_FROM=noreply@tennisportal.com
EMAIL_TRANSPORT=sendmail
# For production, use SMTP:
# EMAIL_TRANSPORT=smtp
# EMAIL_SMTP_HOST=smtp.sendgrid.net
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=apikey
# EMAIL_SMTP_PASSWORD=YOUR_SENDGRID_API_KEY

####################################
# Storage (File Uploads)
####################################
STORAGE_LOCATIONS=local
STORAGE_LOCAL_ROOT=./uploads

####################################
# Extensions
####################################
EXTENSIONS_PATH=./extensions

####################################
# Rate Limiting (Optional)
####################################
RATE_LIMITER_ENABLED=false
RATE_LIMITER_POINTS=25
RATE_LIMITER_DURATION=1

####################################
# Logging
####################################
LOG_LEVEL=info
LOG_STYLE=pretty
